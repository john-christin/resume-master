{
  "manifest_version": 3,
  "name": "AurexViper Resume Assistant",
  "version": "1.0.0",
  "description": "Generate tailored resumes and cover letters directly from any job page",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://aurexviper.pro/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AurexViper Resume Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
