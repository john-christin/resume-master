{
  "name": "aurexviper-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:clean && npm run build:popup && npm run build:sw && npm run build:content && node scripts/copy-assets.js",
    "build:clean": "rm -rf dist",
    "build:popup": "vite build",
    "build:sw": "vite build --config vite.sw.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "dev": "npm run build:clean && npm run build:popup && npm run build:sw && npm run build:content && node scripts/copy-assets.js",
    "watch:popup": "vite build --watch",
    "watch:content": "vite build --config vite.content.config.ts --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
